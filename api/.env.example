# ── Database ─────────────────────────────────────────────────────────────────
DB_USERNAME=postgres
DB_PASSWORD=your_password
DB_HOST=localhost
DB_PORT=5432

# ── Rails ────────────────────────────────────────────────────────────────────
RAILS_ENV=development
SECRET_KEY_BASE=run_bundle_exec_rails_secret
RAILS_LOG_TO_STDOUT=true

# ── JWT ──────────────────────────────────────────────────────────────────────
JWT_SECRET=change_this_to_a_long_random_string_in_production
JWT_EXPIRY_HOURS=24

# ── Admin seed defaults ───────────────────────────────────────────────────────
# Change these before seeding in production.
ADMIN_EMAIL=admin@thembookshop.co.ke
ADMIN_PASSWORD=change_me_before_deploying

# ── M-Pesa / Daraja ──────────────────────────────────────────────────────────
MPESA_CONSUMER_KEY=your_consumer_key
MPESA_CONSUMER_SECRET=your_consumer_secret
MPESA_SHORTCODE=174379
MPESA_PASSKEY=your_passkey
# Must point at the API callback route. Add the token below as a query string.
MPESA_CALLBACK_URL=https://api.yourdomain.co.ke/api/v1/payments/callback
# Shared secret appended to the callback URL (?token=...). Strongly recommended
# in production; leave blank only for sandbox testing.
MPESA_CALLBACK_TOKEN=change_this_to_a_long_random_string
# Optional comma-separated Safaricom source IPs. Leave blank to skip the check.
MPESA_CALLBACK_IPS=
MPESA_ENV=sandbox

# ── Email (SMTP) ─────────────────────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your@gmail.com
SMTP_PASSWORD=your_app_password
MAIL_FROM=noreply@thembookshop.co.ke
ADMIN_EMAIL_NOTIFY=admin@thembookshop.co.ke
ADMIN_URL=https://thembookshop.co.ke/admin

# ── URLs ─────────────────────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:5173
# Public base URL of the API (scheme included). Used for upload URLs and mailers.
APP_HOST=http://localhost:3000
CORS_ORIGINS=http://localhost:5173

# ── Redis / Sidekiq ──────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── Active Storage ───────────────────────────────────────────────────────────
# local (disk) or amazon (S3 / Cloudflare R2, configured below)
ACTIVE_STORAGE_SERVICE=local

# ── AWS S3 / Cloudflare R2 (production storage) ──────────────────────────────
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=af-south-1
AWS_BUCKET=them-bookshop-assets

# ── Sentry (optional monitoring) ─────────────────────────────────────────────
SENTRY_DSN=
