# ── Database ─────────────────────────────────────────────────────────────────
DB_USERNAME=postgres
DB_PASSWORD=your_password
DB_HOST=localhost
DB_PORT=5432

# ── Rails ────────────────────────────────────────────────────────────────────
RAILS_ENV=development
SECRET_KEY_BASE=run_bundle_exec_rails_secret
RAILS_LOG_TO_STDOUT=true

# ── JWT ──────────────────────────────────────────────────────────────────────
JWT_SECRET=change_this_to_a_long_random_string_in_production
JWT_EXPIRY_HOURS=24

# ── Admin seed defaults ───────────────────────────────────────────────────────
ADMIN_EMAIL=admin@thembookshop.co.ke
ADMIN_PASSWORD=Admin@2025!

# ── M-Pesa / Daraja ──────────────────────────────────────────────────────────
MPESA_CONSUMER_KEY=your_consumer_key
MPESA_CONSUMER_SECRET=your_consumer_secret
MPESA_SHORTCODE=174379
MPESA_PASSKEY=your_passkey
MPESA_CALLBACK_URL=https://yourdomain.co.ke/payments/callback
MPESA_ENV=sandbox

# ── Email (SMTP) ─────────────────────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your@gmail.com
SMTP_PASSWORD=your_app_password
MAIL_FROM=noreply@thembookshop.co.ke
ADMIN_EMAIL_NOTIFY=admin@thembookshop.co.ke

# ── URLs ─────────────────────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:5173

# ── Redis / Sidekiq ──────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── AWS S3 (production storage) ──────────────────────────────────────────────
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=af-south-1
AWS_BUCKET=them-bookshop-assets

# ── Sentry (optional monitoring) ─────────────────────────────────────────────
SENTRY_DSN=
