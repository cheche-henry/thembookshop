<!DOCTYPE html>
<html>
  <head>
    <meta http-equiv="Content-Type" content="text/html; charset=utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <style>
      body { font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif; font-size: 15px; line-height: 1.55; color: #2C322D; background: #F3F0E9; margin: 0; padding: 0; }
      .wrapper { max-width: 600px; margin: 32px auto; background: #ffffff; border: 1px solid #E2DED4; border-radius: 6px; overflow: hidden; }
      .header { background: #14412b; padding: 24px 32px; color: #ffffff; }
      .header h1 { margin: 0; font-size: 20px; font-weight: 700; letter-spacing: -0.01em; }
      .header p { margin: 4px 0 0; color: rgba(255,255,255,0.65); font-size: 13px; }
      .body { padding: 32px; }
      h2 { font-size: 20px; }
      h3 { font-size: 15px; margin-top: 24px; }
      .footer { background: #FAF8F3; border-top: 1px solid #E2DED4; padding: 18px 32px; font-size: 12px; color: #5F665F; }
      .btn { display: inline-block; background: #1f7d4f; color: #ffffff !important; text-decoration: none; padding: 11px 24px; border-radius: 4px; font-weight: 600; font-size: 14px; margin-top: 16px; }
      .badge { display: inline-block; padding: 2px 8px; border-radius: 3px; font-size: 12px; font-weight: 600; }
      .badge-pending   { background: #FBF3E3; color: #8A5A00; }
      .badge-paid      { background: #EAF1F5; color: #2B5C86; }
      .badge-completed { background: #d9f2e3; color: #14412b; }
      .badge-processing { background: #F6E9E1; color: #A9552F; }
      .badge-failed    { background: #fdf3f2; color: #A32A22; }
      .badge-cancelled { background: #F3F0E9; color: #5F665F; }
      table.items { width: 100%; border-collapse: collapse; margin-top: 16px; }
      table.items th { text-align: left; padding: 8px 12px; background: #FAF8F3; border-bottom: 1px solid #E2DED4; font-size: 11px; color: #5F665F; text-transform: uppercase; letter-spacing: 0.06em; }
      table.items td { padding: 10px 12px; border-bottom: 1px solid #E2DED4; font-size: 14px; }
      .total-row td { font-weight: 700; font-size: 15px; border-top: 2px solid #CFC9BC; border-bottom: none; }
    </style>
  </head>
  <body>
    <div class="wrapper">
      <div class="header">
        <h1>Them Bookshop</h1>
        <p>School books and supplies, Kenya</p>
      </div>
      <div class="body">
        <%= yield %>
      </div>
      <div class="footer">
        <p style="margin:0">This message was sent by Them Bookshop about an order placed on our website.</p>
      </div>
    </div>
  </body>
</html>
