<h2 style="color:#14412b;margin-top:0">New order received</h2>
<p>A new order has been placed and is waiting for attention in the dashboard.</p>

<div style="background:#FAF8F3;border:1px solid #E2DED4;border-radius:4px;padding:16px 20px;margin:20px 0;">
  <strong>Reference:</strong> <code><%= @order.reference %></code><br/>
  <strong>Customer:</strong> <%= @order.customer_name %><br/>
  <strong>Phone:</strong> <%= @order.customer_phone %><br/>
  <strong>Email:</strong> <%= @order.customer_email.presence || "Not provided" %><br/>
  <strong>Total:</strong> KES <%= @order.total_amount.to_i %><br/>
  <strong>Delivery to:</strong> <%= @order.delivery_address %>
</div>

<h3 style="color:#161A17">Items ordered</h3>
<table class="items">
  <thead><tr><th>Product</th><th>Qty</th><th>Unit price</th><th>Total</th></tr></thead>
  <tbody>
    <% @order_items.each do |item| %>
    <tr>
      <td><%= item.product_name_snapshot %></td>
      <td><%= item.quantity %></td>
      <td>KES <%= item.unit_price.to_i %></td>
      <td>KES <%= item.total_price.to_i %></td>
    </tr>
    <% end %>
  </tbody>
</table>

<a href="<%= @admin_url %>/orders/<%= @order.id %>" class="btn">View order in the dashboard</a>
