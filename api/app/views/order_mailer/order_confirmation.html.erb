<h2 style="color:#14412b;margin-top:0">Hello <%= @order.customer_name %></h2>
<p>Thank you for your order. We have received it and will begin processing once payment is confirmed.</p>

<div style="background:#FAF8F3;border:1px solid #E2DED4;border-radius:4px;padding:16px 20px;margin:20px 0;">
  <strong>Order reference:</strong> <code style="background:#F3F0E9;padding:2px 8px;border-radius:3px"><%= @order.reference %></code><br/>
  <strong>Status:</strong> <span class="badge badge-pending">Pending payment</span><br/>
  <strong>Date:</strong> <%= @order.created_at.strftime("%d %B %Y, %H:%M") %>
</div>

<h3 style="color:#161A17">Order summary</h3>
<table class="items">
  <thead>
    <tr><th>Item</th><th>Qty</th><th>Price</th></tr>
  </thead>
  <tbody>
    <% @order_items.each do |item| %>
    <tr>
      <td><%= item.product_name_snapshot %></td>
      <td><%= item.quantity %></td>
      <td>KES <%= item.total_price.to_i %></td>
    </tr>
    <% end %>
    <tr><td colspan="2">Delivery</td><td><%= @order.delivery_fee.zero? ? "Free" : "KES #{@order.delivery_fee.to_i}" %></td></tr>
  </tbody>
  <tfoot>
    <tr class="total-row">
      <td colspan="2">Total</td>
      <td>KES <%= @order.total_amount.to_i %></td>
    </tr>
  </tfoot>
</table>

<h3 style="color:#161A17">Delivery details</h3>
<p><strong>Name:</strong> <%= @order.customer_name %><br/>
<strong>Phone:</strong> <%= @order.customer_phone %><br/>
<strong>Address:</strong> <%= @order.delivery_address %></p>

<p style="margin-top:24px;font-size:13px;color:#5F665F;">
  An M-Pesa payment prompt will be sent to <strong><%= @order.customer_phone %></strong>.
  Enter your PIN on your phone to complete payment. The order is confirmed once payment is received.
</p>
