<h2 style="color:#1f7d4f;margin-top:0">Hi <%= @order.customer_name %> 👋</h2>
<p>Thank you for your order! We've received it and will process it shortly.</p>

<div style="background:#f0faf4;border-radius:8px;padding:16px 20px;margin:20px 0;">
  <strong>Order Reference:</strong> <code style="background:#d9f2e3;padding:2px 8px;border-radius:4px"><%= @order.reference %></code><br/>
  <strong>Status:</strong> <span class="badge badge-pending">Pending Payment</span><br/>
  <strong>Date:</strong> <%= @order.created_at.strftime("%d %B %Y, %H:%M") %>
</div>

<h3 style="color:#374151">Order Summary</h3>
<table class="items">
  <thead>
    <tr><th>Item</th><th>Qty</th><th>Price</th></tr>
  </thead>
  <tbody>
    <% @order_items.each do |item| %>
    <tr>
      <td><%= item.product_name_snapshot %></td>
      <td><%= item.quantity %></td>
      <td>KES <%= item.total_price.to_i %></td>
    </tr>
    <% end %>
    <tr><td colspan="2">Delivery</td><td><%=  @order.delivery_fee.zero? ? "FREE" : "KES #{@order.delivery_fee.to_i}" %></td></tr>
  </tbody>
  <tfoot>
    <tr class="total-row">
      <td colspan="2">Total</td>
      <td>KES <%= @order.total_amount.to_i %></td>
    </tr>
  </tfoot>
</table>

<h3 style="color:#374151">Delivery Details</h3>
<p><strong>Name:</strong> <%= @order.customer_name %><br/>
<strong>Phone:</strong> <%= @order.customer_phone %><br/>
<strong>Address:</strong> <%= @order.delivery_address %></p>

<p style="margin-top:24px;font-size:13px;color:#6b7280;">
  You will receive an M-Pesa payment prompt on <strong><%= @order.customer_phone %></strong> shortly.
  Enter your PIN to complete payment. Questions? Reply to this email or call <strong>+254 700 000 000</strong>.
</p>
