<h2 style="color:#14412b;margin-top:0">Order update</h2>
<p>Hello <strong><%= @order.customer_name %></strong>, the status of your order has changed.</p>

<div style="background:#FAF8F3;border:1px solid #E2DED4;border-radius:4px;padding:16px 20px;margin:20px 0;">
  <strong>Order reference:</strong> <%= @order.reference %><br/>
  <strong>New status:</strong>
  <span class="badge badge-<%= @order.status %>"><%= @order.status.humanize %></span>
</div>

<% if @order.status == "completed" %>
<p>Your order has been delivered. Thank you for shopping with Them Bookshop.</p>
<% elsif @order.status == "processing" %>
<p>Your order is being prepared for delivery.</p>
<% end %>

<p style="margin-top:24px;font-size:13px;color:#5F665F;">
  Keep this reference handy in case you need to ask about the order.
</p>
