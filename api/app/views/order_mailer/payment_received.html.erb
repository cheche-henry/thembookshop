<h2 style="color:#14412b;margin-top:0">Payment received</h2>
<p>Hello <strong><%= @order.customer_name %></strong>, your payment has been confirmed.</p>

<div style="background:#f0faf4;border:1px solid #b3e5c8;border-left:3px solid #1f7d4f;border-radius:4px;padding:16px 20px;margin:20px 0;">
  <strong>Order:</strong> <%= @order.reference %><br/>
  <strong>Amount paid:</strong> KES <%= @order.total_amount.to_i %><br/>
  <% if @payment&.mpesa_receipt_number.present? %>
  <strong>M-Pesa receipt:</strong> <%= @payment.mpesa_receipt_number %><br/>
  <% end %>
  <strong>Status:</strong> <span class="badge badge-paid">Paid</span>
</div>

<p>We are now preparing your order for delivery. We will email you again when its status changes.</p>
